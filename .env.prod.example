# Website Builder production environment example for Aliyun ECS 2c2g.
# Copy to .env.prod on the server and replace secrets before starting.

PUBLIC_BASE_URL=http://www.chunchang.tech

POSTGRES_DB=website_builder
POSTGRES_USER=wb_user
POSTGRES_PASSWORD=change-this-postgres-password

# Must be at least 32 characters. Generate a new value for production.
JWT_SECRET=change-this-jwt-secret-at-least-32-chars
