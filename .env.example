# Copy to .env for a local trial. Never commit .env or use these placeholders as credentials.
PAYLOAD_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=file:/absolute/path/to/company-website/data/content.sqlite
MEDIA_DIR=/absolute/path/to/company-website/data/media
SITE_URL=http://localhost:3001
# Local HTTP trial: false. Production HTTPS: true.
COOKIE_SECURE=false
# true only behind the supplied Nginx configuration that replaces X-Real-IP.
TRUST_PROXY_IP=false
# true identifies demonstration content. Change only after replacing and verifying that content.
DEMO_MODE=true
# Used by the administrator bootstrap command, not by public visitors.
ADMIN_EMAIL=replace-with-your-admin-email
ADMIN_PASSWORD=replace-with-a-unique-long-password
